# .streamlit/secrets.toml.example
#
# DO NOT commit real values to the repo.
# This file shows the required structure only.
#
# To configure:
#   Streamlit Cloud → your app → Settings → Secrets
#   Paste the content below with your real values filled in.
#
# For local development:
#   Copy this file to .streamlit/secrets.toml (already in .gitignore)
#   and fill in real values.

[admin]
password = "choose-a-strong-password-here"
api_key  = "sk-ant-your-anthropic-key-here"
